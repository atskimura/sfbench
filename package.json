{
  "name": "sfbench",
  "version": "0.1.0",
  "description": "A local workbench for Salesforce: SOQL, Apex and REST API, powered by your sf CLI auth",
  "keywords": [
    "salesforce",
    "soql",
    "sf-cli",
    "sfdx",
    "apex",
    "rest-api"
  ],
  "homepage": "https://github.com/atskimura/sfbench#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atskimura/sfbench.git"
  },
  "bugs": {
    "url": "https://github.com/atskimura/sfbench/issues"
  },
  "author": "atskimura",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sfbench": "dist/server/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.21.0 || >=24.5.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.21.0 || >=24.5.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "node --use-env-proxy --watch src/server/cli.ts --dev",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run --passWithNoTests",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -b && vite build",
    "prepublishOnly": "node scripts/check-release.mjs && npm run lint && npm test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-virtual": "^3.14.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "soql-parser-js": "^5.0.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
